<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "windows-binaries" (paste into the qabas1-cli project).
     Input: GitHub artifact zip with both qabas.exe builds and install.ps1. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="qabas_*_windows_amd64.exe" />
      <include path="qabas_*_windows_arm64.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
    <powershell-file path="install.ps1">
      <authenticode-sign />
    </powershell-file>
  </zip-file>
</artifact-configuration>
