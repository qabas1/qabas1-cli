<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 package for the qabas CLI. Built by packaging/windows/build-msi.ps1:
    wix build qabas.wxs -arch x64|arm64 -ext WixToolset.UI.wixext
      -d Version=x.y.z -d ExeSource=path\to\qabas.exe -d AssetsDir=path\to\assets
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?if $(sys.BUILDARCH) = x64 ?>
    <?define ComponentGuid = "A11C2B3D-4E5F-6780-9ABC-DEF012345601" ?>
  <?elseif $(sys.BUILDARCH) = arm64 ?>
    <?define ComponentGuid = "A11C2B3D-4E5F-6780-9ABC-DEF012345602" ?>
  <?else?>
    <?error Unsupported -arch $(sys.BUILDARCH); use x64 or arm64 ?>
  <?endif?>

  <!-- UpgradeCode is shared with the earlier wixl-built MSIs so existing installs upgrade in place. -->
  <Package
      Name="QabasOne CLI"
      Manufacturer="QabasOne"
      Version="$(Version)"
      UpgradeCode="8F3C2A1B-4D5E-6F70-8A9B-C0D1E2F3A4B5"
      Language="1033"
      Scope="perMachine"
      Compressed="yes">

    <SummaryInformation
        Description="Official system administration CLI for QabasOne"
        Manufacturer="QabasOne" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of QabasOne CLI is already installed. Uninstall it first, or use -AllowDowngrade with the bootstrap script." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="QabasIcon" SourceFile="$(AssetsDir)\qabas.ico" />
    <Property Id="ARPPRODUCTICON" Value="QabasIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://qabas.one" />
    <Property Id="ARPHELPLINK" Value="https://github.com/qabas1/qabas1-cli/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/qabas1/qabas1-cli/releases" />
    <Property Id="ARPCONTACT" Value="QabasOne" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="QabasOne CLI was added to your PATH. Open a new terminal and run 'qabas --help' to get started." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="qabas" />
    </StandardDirectory>

    <Component Id="QabasExe" Directory="INSTALLFOLDER" Guid="$(ComponentGuid)">
      <File Id="QabasExeFile" Source="$(ExeSource)" Name="qabas.exe" KeyPath="yes" />
      <Environment
          Id="QabasPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
    </Component>

    <Feature Id="Main" Title="QabasOne CLI" Level="1">
      <ComponentRef Id="QabasExe" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(AssetsDir)\License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(AssetsDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(AssetsDir)\dialog.bmp" />
  </Package>
</Wix>
